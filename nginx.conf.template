worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    # 显式声明 .mjs 为 ES Module 类型：nginx 自带 mime.types 在不同版本里
    # 对 .mjs 处理不一致，若被识别为 application/octet-stream，浏览器会拒绝
    # 以 ES module 执行（PDF.js worker 即典型受害者）。
    types {
        application/javascript  mjs;
    }
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    server_tokens off;

    # Writable paths for the unprivileged container user.
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    server {
        listen 0.0.0.0:${PORT};
        server_name _;
        root /usr/share/nginx/html;
        index index.html;
        client_max_body_size 20m;

        # Frontend-only health check
        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "saiflow-web ok\n";
        }

        # /api/* 转发到后端（后端路由本身已带 /api 前缀，直接透传，不再 rewrite）
        # /api/login  -> 后端 /api/login
        # /api/uploads/x.png -> 后端 /api/uploads/x.png
        location /api/ {
            proxy_pass ${BACKEND_HOST};
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host ${BACKEND_HOST_NAME};
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_connect_timeout 10s;
            proxy_send_timeout 120s;
            proxy_read_timeout 120s;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_intercept_errors off;
        }

        # Do not turn missing JavaScript/CSS files into index.html responses.
        location ^~ /assets/ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=3600";
        }

        location = /index.html {
            add_header Cache-Control "no-cache" always;
        }

        # Vue Router history-mode fallback.
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
